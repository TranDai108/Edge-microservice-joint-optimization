# ─────────────────────────────────────────────────────────
# KLTN Edge Computing - Client UI Config (For Mac/Windows)
# ─────────────────────────────────────────────────────────

# Trỏ thẳng đến IP kết nối thực tế của máy chủ OpenStack (qua VPN)
GATEWAY_URL=http://192.168.113.120:30080

# '0' tự động mở webcam vật lý trên laptop của bạn
VIDEO_SOURCE=0

# FPS an toàn để truyền qua VPN mà không bị nghẽn mạng nặng
TARGET_FPS=5

# Bật giao diện UI đồ hoạ lên để soi kết quả Detection thật
DISPLAY_VIDEO=True

SLA_MS=1500
TIMEOUT_SEC=15
RESULTS_FILE=client_results_local.jsonl
