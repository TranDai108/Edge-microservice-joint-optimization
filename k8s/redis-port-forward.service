[Unit]
Description=kubectl port-forward Redis (localhost:6379)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Environment=KUBECONFIG=/home/ubuntu/.kube/config
ExecStart=/usr/local/bin/kubectl port-forward svc/redis -n default 6379:6379
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
